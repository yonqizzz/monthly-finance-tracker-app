{
  "expo": {
    "name": "Finance Tracker",
    "slug": "finance-universal",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#14100E",
    "ios": {
      "backgroundColor": "#14100E",
      "supportsTablet": true,
      "bundleIdentifier": "com.yonqi.financeuniversal"
    },
    "android": {
      "backgroundColor": "#14100E",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F4",
        "foregroundImage": "./assets/wallet_icon_transparent.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yonqi.financeuniversal"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "908a2a35-b85d-4a6b-b361-f2d69a36516b"
      }
    },
    "owner": "yonqi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/908a2a35-b85d-4a6b-b361-f2d69a36516b"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/wallet_icon_transparent.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F4",
          "dark": {
            "image": "./assets/wallet_icon_transparent.png",
            "backgroundColor": "#14100E"
          }
        }
      ]
    ]
  }
}
